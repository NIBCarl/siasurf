APP_NAME=SiaSurf
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_FORCE_HTTPS=true
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database (MySQL 8.x on CloudPanel / Azure VM)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siasurf
DB_USERNAME=siasurf_user
DB_PASSWORD=

# Database-backed sessions, cache, and queues (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail (Brevo free SMTP relay or Gmail App Password)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="SiaSurf"
MAIL_TIMEOUT=15

# ---------------------------------------------------------------------------
# SiaSurf specific
# ---------------------------------------------------------------------------

# Public HTTPS base URL encoded into scannable instructor QR codes
SIASURF_PUBLIC_URL=https://your-domain.com

# Payments (leave blank to use MockPaymentService for demos)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_MODE=live

# Optional alternative gateway (takes precedence over PayMongo when set)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CALLBACK_URL=

# Laravel Reverb WebSockets (proxied over HTTPS port 443 via Nginx)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Vite bakes VITE_* variables into the JS bundle during `npm run build`
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Stormglass.io tide data (free tier: 10 calls/day; cached 48h)
STORMGLASS_API_KEY=

# Keep false on 1-2 GB VMs (ClamAV uses ~1 GB RAM)
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_BINARY=clamdscan

# Feedback, strikes, and suspensions
SIASURF_AUTO_CONFIRM_REPORTS=false
SIASURF_STANDARD_REVIEW_HOURS=24
SIASURF_CRITICAL_REVIEW_HOURS=4
SIASURF_STRIKE_THRESHOLD=3
SIASURF_SUSPENSION_DAYS=30

# Seeded SISA admin account — change immediately after first login
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
